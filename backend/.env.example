# Defaults work without an .env file. Never commit real secrets.
DRDOC_APP_NAME=Dr.Doc
DRDOC_ENVIRONMENT=development
# Copy the direct PostgreSQL URL from Neon Connect, preserving its SSL parameters.
# Leave empty until a database is available. Never share or commit the real URL.
DRDOC_DATABASE_URL=
# Google AI Studio key from a Free-tier project; never enable billing for this app.
DRDOC_GEMINI_API_KEY=
